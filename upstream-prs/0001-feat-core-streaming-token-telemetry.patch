From 7c3a1b8e9f2d1e0a4c5b6a7b8c9d0e1f2a3b4c5d Mon Sep 17 00:00:00 2001
From: Balaharish Saravanan <balaharish0202@gmail.com>
Date: Mon, 16 Nov 2026 12:00:00 +0000
Subject: [PATCH] feat(core): emit streaming token usage telemetry in SSE events and response headers

TrueForge SSE streams currently emit text deltas without intermediate
token counters or cost metrics. This commit enhances the SSE stream
pipeline to emit periodic `token_usage` events and sets standard
telemetry headers:
- X-TrueForge-Prompt-Tokens
- X-TrueForge-Completion-Tokens
- X-TrueForge-Cost-USD
- X-TrueForge-Latency-Ms

This allows client extensions (such as ForgeCode) to render real-time
token tickers and calculate cost HUD metrics mid-flight.

Signed-off-by: Balaharish Saravanan <balaharish0202@gmail.com>
---
 packages/core/src/server/sseHandler.ts       | 38 ++++++++++++++++++++
 packages/core/src/types/telemetry.ts         | 18 ++++++++++
 packages/core/test/sseTelemetry.test.ts      | 32 ++++++++++++++++
 3 files changed, 88 insertions(+)
 create mode 100644 packages/core/src/types/telemetry.ts
 create mode 100644 packages/core/test/sseTelemetry.test.ts

diff --git a/packages/core/src/types/telemetry.ts b/packages/core/src/types/telemetry.ts
new file mode 100644
index 0000000..e1b2c3d
--- /dev/null
+++ b/packages/core/src/types/telemetry.ts
@@ -0,0 +1,18 @@
+export interface StreamTelemetry {
+  promptTokens: number;
+  completionTokens: number;
+  totalTokens: number;
+  estimatedCostUsd: number;
+  latencyMs: number;
+}
+
+export interface TokenUsageSSEEvent {
+  type: 'token_usage';
+  data: StreamTelemetry;
+}
diff --git a/packages/core/src/server/sseHandler.ts b/packages/core/src/server/sseHandler.ts
index a1b2c3d..e2f3a4b 100644
--- a/packages/core/src/server/sseHandler.ts
+++ b/packages/core/src/server/sseHandler.ts
@@ -15,6 +15,7 @@ import { Response } from 'express';
+import { StreamTelemetry, TokenUsageSSEEvent } from '../types/telemetry';
 
 export class SseStreamWriter {
   private res: Response;
+  private startTime: number;
+  private promptTokens: number = 0;
+  private completionTokens: number = 0;
 
   constructor(res: Response) {
     this.res = res;
+    this.startTime = Date.now();
   }
 
+  public setPromptTokens(tokens: number): void {
+    this.promptTokens = tokens;
+    this.res.setHeader('X-TrueForge-Prompt-Tokens', tokens.toString());
+  }
+
   public sendDelta(delta: string): void {
+    this.completionTokens += Math.ceil(delta.length / 3.8);
     this.res.write(`event: delta\ndata: ${JSON.stringify({ text: delta })}\n\n`);
+    
+    // Emit periodic token usage every ~50 tokens
+    if (this.completionTokens % 50 === 0) {
+      this.emitTokenUsage();
+    }
   }
 
+  public emitTokenUsage(): void {
+    const latencyMs = Date.now() - this.startTime;
+    const cost = (this.promptTokens * 0.00000015) + (this.completionTokens * 0.00000060);
+    const payload: TokenUsageSSEEvent = {
+      type: 'token_usage',
+      data: {
+        promptTokens: this.promptTokens,
+        completionTokens: this.completionTokens,
+        totalTokens: this.promptTokens + this.completionTokens,
+        estimatedCostUsd: Number(cost.toFixed(6)),
+        latencyMs
+      }
+    };
+    this.res.write(`event: token_usage\ndata: ${JSON.stringify(payload.data)}\n\n`);
+    this.res.setHeader('X-TrueForge-Completion-Tokens', this.completionTokens.toString());
+    this.res.setHeader('X-TrueForge-Cost-USD', cost.toFixed(6));
+    this.res.setHeader('X-TrueForge-Latency-Ms', latencyMs.toString());
+  }
+
   public sendDone(): void {
+    this.emitTokenUsage();
     this.res.write(`event: done\ndata: {}\n\n`);
     this.res.end();
   }
 }
diff --git a/packages/core/test/sseTelemetry.test.ts b/packages/core/test/sseTelemetry.test.ts
new file mode 100644
index 0000000..f3e2d1c
--- /dev/null
+++ b/packages/core/test/sseTelemetry.test.ts
@@ -0,0 +1,32 @@
+import { describe, it, expect, vi } from 'vitest';
+import { SseStreamWriter } from '../src/server/sseHandler';
+
+describe('SseStreamWriter Telemetry', () => {
+  it('emits token_usage events with calculated tokens and latency', () => {
+    const mockRes = {
+      write: vi.fn(),
+      setHeader: vi.fn(),
+      end: vi.fn()
+    } as any;
+
+    const writer = new SseStreamWriter(mockRes);
+    writer.setPromptTokens(1500);
+
+    expect(mockRes.setHeader).toHaveBeenCalledWith('X-TrueForge-Prompt-Tokens', '1500');
+
+    writer.sendDelta('def sample_code():\n    return 42\n');
+    writer.sendDone();
+
+    expect(mockRes.write).toHaveBeenCalledWith(expect.stringContaining('event: token_usage'));
+    expect(mockRes.setHeader).toHaveBeenCalledWith('X-TrueForge-Completion-Tokens', expect.any(String));
+  });
+});
